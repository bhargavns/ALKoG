<mujoco model="kg_world">
    <compiler angle="degree" inertiafromgeom="true"/>
    <option integrator="RK4" timestep="0.01"/>
    <visual>
        <global offwidth="1024" offheight="1024"/>
        <map fogend="30" fogstart="20"/>
        <quality shadowsize="2048"/>
    </visual>
    <asset>
        <texture builtin="gradient" height="100" rgb1=".45 .55 .65" rgb2=".15 .15 .2" type="skybox" width="100"/>
        <material name="MatPlane" reflectance="0" shininess="0.1" specular="0.1" rgba="0.72 0.72 0.75 1"/>
    </asset>
    <worldbody>
        <light castshadow="false" cutoff="100" diffuse="0.55 0.55 0.55" dir="-0.3 -0.3 -1" directional="true" pos="4 4 6" specular=".1 .1 .1"/>
        <light castshadow="false" cutoff="100" diffuse="0.25 0.25 0.25" dir="0.3 0.3 -1" directional="true" pos="-4 -4 6" specular="0 0 0"/>
        <geom condim="3" friction="1 .1 .1" material="MatPlane" name="floor" pos="0 0 0" size="8 8 0.125" type="plane"/>

        <!-- Agent: velocity-controlled ball with a 4-camera panoramic rig -->
        <body name="agent" pos="0 0 0.25">
            <joint name="agent_x" type="slide" axis="1 0 0" range="-7.5 7.5" damping="2" limited="true"/>
            <joint name="agent_y" type="slide" axis="0 1 0" range="-7.5 7.5" damping="2" limited="true"/>
            <joint name="agent_yaw" type="hinge" axis="0 0 1" damping="0.5" limited="false"/>
            <geom name="agent_ball" type="sphere" size="0.25" rgba="0.25 0.25 0.3 1" density="200"/>
            <geom name="agent_nose" type="sphere" size="0.08" pos="0.24 0 0.1" rgba="0.9 0.9 0.2 1" contype="0" conaffinity="0"/>
            <camera name="cam_front" pos="0.1 0 0.9"  fovy="90" xyaxes="0 -1 0 0.259 0 0.966"/>
            <camera name="cam_left"  pos="0 0.1 0.9"  fovy="90" xyaxes="1 0 0 0 0.259 0.966"/>
            <camera name="cam_back"  pos="-0.1 0 0.9" fovy="90" xyaxes="0 1 0 -0.259 0 0.966"/>
            <camera name="cam_right" pos="0 -0.1 0.9" fovy="90" xyaxes="-1 0 0 0 -0.259 0.966"/>
        </body>

        <!-- Lion: orange-red sphere cluster; repositioned at reset -->
        <body name="lion" pos="4 0 0">
            <geom name="lion_body" type="sphere" size="0.45" pos="0 0 0.45" rgba="0.85 0.4 0.05 1" contype="0" conaffinity="0"/>
            <geom name="lion_head" type="sphere" size="0.28" pos="0.42 0 0.72" rgba="0.75 0.3 0.0 1" contype="0" conaffinity="0"/>
            <geom name="lion_mane" type="sphere" size="0.33" pos="0.34 0 0.74" rgba="0.5 0.2 0.0 1" contype="0" conaffinity="0"/>
        </body>

        <!-- Food: bright green sphere; repositioned at reset -->
        <body name="food" pos="0 4 0">
            <geom name="food_item" type="sphere" size="0.3" pos="0 0 0.3" rgba="0.1 0.85 0.1 1" contype="0" conaffinity="0"/>
        </body>

        <!-- Water: cyan low cylinder with a bright center; repositioned at reset -->
        <body name="water" pos="2 -4 0">
            <geom name="water_pool" type="cylinder" size="0.42 0.035" pos="0 0 0.035" rgba="0.0 0.75 0.95 1" contype="0" conaffinity="0"/>
            <geom name="water_center" type="sphere" size="0.16" pos="0 0 0.12" rgba="0.3 0.95 1.0 1" contype="0" conaffinity="0"/>
        </body>

        <!-- Poison: magenta hazard made visually distinct from all resources -->
        <body name="poison" pos="-2 -4 0">
            <geom name="poison_base" type="cylinder" size="0.36 0.08" pos="0 0 0.08" rgba="0.8 0.02 0.75 1" contype="0" conaffinity="0"/>
            <geom name="poison_core" type="sphere" size="0.23" pos="0 0 0.27" rgba="1.0 0.1 0.75 1" contype="0" conaffinity="0"/>
            <geom name="poison_tip" type="capsule" size="0.10 0.18" pos="0 0 0.56" rgba="0.55 0.0 0.5 1" contype="0" conaffinity="0"/>
        </body>

        <!-- Cage: ring of 12 blue bars + top rim + base disc; repositioned at reset -->
        <body name="cage" pos="-4 3 0">
            <geom name="cage_base" type="cylinder" size="1.2 0.03" pos="0 0 0.03" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_0"  type="capsule" fromto="1.1 0 0.05 1.1 0 1.15"           size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_1"  type="capsule" fromto="0.9526 0.55 0.05 0.9526 0.55 1.15"   size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_2"  type="capsule" fromto="0.55 0.9526 0.05 0.55 0.9526 1.15"   size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_3"  type="capsule" fromto="0 1.1 0.05 0 1.1 1.15"           size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_4"  type="capsule" fromto="-0.55 0.9526 0.05 -0.55 0.9526 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_5"  type="capsule" fromto="-0.9526 0.55 0.05 -0.9526 0.55 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_6"  type="capsule" fromto="-1.1 0 0.05 -1.1 0 1.15"         size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_7"  type="capsule" fromto="-0.9526 -0.55 0.05 -0.9526 -0.55 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_8"  type="capsule" fromto="-0.55 -0.9526 0.05 -0.55 -0.9526 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_9"  type="capsule" fromto="0 -1.1 0.05 0 -1.1 1.15"         size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_10" type="capsule" fromto="0.55 -0.9526 0.05 0.55 -0.9526 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_bar_11" type="capsule" fromto="0.9526 -0.55 0.05 0.9526 -0.55 1.15" size="0.09" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_0"  type="capsule" fromto="1.1 0 1.15 0.9526 0.55 1.15"         size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_1"  type="capsule" fromto="0.9526 0.55 1.15 0.55 0.9526 1.15"   size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_2"  type="capsule" fromto="0.55 0.9526 1.15 0 1.1 1.15"         size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_3"  type="capsule" fromto="0 1.1 1.15 -0.55 0.9526 1.15"        size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_4"  type="capsule" fromto="-0.55 0.9526 1.15 -0.9526 0.55 1.15" size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_5"  type="capsule" fromto="-0.9526 0.55 1.15 -1.1 0 1.15"       size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_6"  type="capsule" fromto="-1.1 0 1.15 -0.9526 -0.55 1.15"      size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_7"  type="capsule" fromto="-0.9526 -0.55 1.15 -0.55 -0.9526 1.15" size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_8"  type="capsule" fromto="-0.55 -0.9526 1.15 0 -1.1 1.15"      size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_9"  type="capsule" fromto="0 -1.1 1.15 0.55 -0.9526 1.15"       size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_10" type="capsule" fromto="0.55 -0.9526 1.15 0.9526 -0.55 1.15" size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
            <geom name="cage_rim_11" type="capsule" fromto="0.9526 -0.55 1.15 1.1 0 1.15"        size="0.05" rgba="0.1 0.15 0.6 1" contype="0" conaffinity="0"/>
        </body>
    </worldbody>
    <actuator>
        <velocity name="vel_x"   joint="agent_x"   kv="50" ctrlrange="-2.5 2.5"/>
        <velocity name="vel_y"   joint="agent_y"   kv="50" ctrlrange="-2.5 2.5"/>
        <velocity name="vel_yaw" joint="agent_yaw" kv="5"  ctrlrange="-3 3"/>
    </actuator>
</mujoco>
